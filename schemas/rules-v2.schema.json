{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-rules:rules:2",
  "title": "Context-aware content rule set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_set",
    "sources",
    "fact_definitions",
    "rules",
    "conflict_groups"
  ],
  "properties": {
    "schema_version": {
      "const": "content-rule-set/2"
    },
    "rule_set": {
      "$ref": "#/$defs/rule_set"
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "fact_definitions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/fact_definition"
      }
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "conflict_groups": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/conflict_group"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "bounded_string": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      ]
    },
    "identifier_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "string_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/bounded_string"
      }
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "owner",
        "decision_ref"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "proposed",
            "adopted"
          ]
        },
        "owner": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "adopted"
              }
            }
          },
          "then": {
            "properties": {
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "\\S"
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "owner": {
                "const": null
              },
              "decision_ref": {
                "const": null
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?=[\\s\\S]*\\S)(?!/|~)(?!.*://)(?!.*\\\\)(?!.*(?:/\\.\\./|^\\.\\./|/\\.\\.$|^\\.\\.$))[^:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "line_start",
        "line_end",
        "quote"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/source_ref"
      }
    },
    "accepted_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "provider"
      ],
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "declared",
            "derived"
          ]
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "fact_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "level",
        "type",
        "accepted_sources"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "level": {
          "enum": [
            "artifact",
            "instance"
          ]
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer"
          ]
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "accepted_sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/accepted_source"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "maxItems": 2,
                "items": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "integer",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                }
              }
            }
          }
        }
      ]
    },
    "condition_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "op",
        "value"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/identifier"
        },
        "op": {
          "enum": [
            "equals",
            "not_equals"
          ]
        },
        "value": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "condition_one_of": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "op",
        "values"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/identifier"
        },
        "op": {
          "const": "one_of"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        }
      }
    },
    "condition_leaf": {
      "oneOf": [
        {
          "$ref": "#/$defs/condition_comparison"
        },
        {
          "$ref": "#/$defs/condition_one_of"
        }
      ]
    },
    "applies_when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all",
        "source_refs"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/condition_leaf"
          }
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaces",
        "fields"
      ],
      "properties": {
        "surfaces": {
          "$ref": "#/$defs/string_list"
        },
        "fields": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "check",
        "scope",
        "params",
        "source_refs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "check": {
          "enum": [
            "banned_terms",
            "character_limit",
            "required_terminology",
            "required_fields"
          ]
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "params": {
          "type": "object"
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        },
        "applies_when": {
          "$ref": "#/$defs/applies_when"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "check"
            ],
            "properties": {
              "check": {
                "const": "banned_terms"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/banned_terms_params"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "check"
            ],
            "properties": {
              "check": {
                "const": "character_limit"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/character_limit_params"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "check"
            ],
            "properties": {
              "check": {
                "const": "required_terminology"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/required_terminology_params"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "check"
            ],
            "properties": {
              "check": {
                "const": "required_fields"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/required_fields_params"
              },
              "scope": {
                "properties": {
                  "fields": {
                    "const": [
                      "*"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "match": {
      "enum": [
        "whole",
        "substring"
      ]
    },
    "banned_terms_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terms",
        "case_sensitive",
        "match"
      ],
      "properties": {
        "terms": {
          "$ref": "#/$defs/string_list"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "match": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "character_limit_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum",
        "count"
      ],
      "properties": {
        "maximum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "count": {
          "const": "unicode_code_points"
        }
      }
    },
    "required_terminology_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred",
        "instead_of",
        "case_sensitive",
        "match"
      ],
      "properties": {
        "preferred": {
          "$ref": "#/$defs/bounded_string"
        },
        "instead_of": {
          "$ref": "#/$defs/string_list"
        },
        "case_sensitive": {
          "type": "boolean"
        },
        "match": {
          "$ref": "#/$defs/match"
        }
      }
    },
    "required_fields_params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "require_non_empty"
      ],
      "properties": {
        "fields": {
          "$ref": "#/$defs/string_list"
        },
        "require_non_empty": {
          "type": "boolean"
        }
      }
    },
    "supersession_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "supersedes",
        "decision_ref",
        "source_refs"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "supersedes": {
          "$ref": "#/$defs/identifier"
        },
        "decision_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/source_refs"
        }
      }
    },
    "conflict_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "members",
        "supersession"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "supersession": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/supersession_edge"
          }
        }
      }
    }
  }
}
