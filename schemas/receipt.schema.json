{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-rules:receipt:1",
  "title": "Content rule receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "tool",
    "rule_set",
    "sources",
    "artifact",
    "summary",
    "results"
  ],
  "properties": {
    "protocol": {
      "const": "content-rule-receipt/1"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "content-rules"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "owner",
        "decision_ref",
        "effect",
        "path",
        "sha256",
        "canonical_sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "adopted"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "status": {
            "const": "VERIFIED"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "canonical_sha256",
        "instance_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "instance_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applicable",
        "passed",
        "failed",
        "review",
        "unresolved_evidence",
        "not_applicable"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "REVIEW",
            "NOT_APPLICABLE"
          ]
        },
        "applicable": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "review": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_evidence": {
          "type": "integer",
          "minimum": 0
        },
        "not_applicable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "description",
          "check",
          "scope",
          "source_refs",
          "status",
          "message",
          "evidence",
          "review_evidence"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "scope": {
            "type": "object"
          },
          "source_refs": {
            "type": "array"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "REVIEW",
              "NOT_APPLICABLE"
            ]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "review_evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
