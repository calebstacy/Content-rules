{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-rules:candidates:2",
  "title": "Context-aware content rule candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "units"
  ],
  "properties": {
    "schema_version": {
      "const": "content-rule-candidates/2"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "units": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/unit"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^(?=[\\s\\S]*\\S)(?!/|~)(?!.*://)(?!.*\\\\)(?!.*(?:/\\.\\./|^\\.\\./|/\\.\\.$|^\\.\\.$))[^:]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "required_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "level",
        "type",
        "reason"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/identifier"
        },
        "level": {
          "enum": [
            "artifact",
            "instance"
          ]
        },
        "type": {
          "enum": [
            "string",
            "boolean",
            "integer"
          ]
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scalar"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "maxItems": 2,
                "items": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "allowed_values": {
                "items": {
                  "type": "integer",
                  "minimum": -1000000000,
                  "maximum": 1000000000
                }
              }
            }
          }
        }
      ]
    },
    "fact_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact",
        "status",
        "basis",
        "provider",
        "ref",
        "reason"
      ],
      "properties": {
        "fact": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "confirmed",
            "proposed",
            "missing"
          ]
        },
        "basis": {
          "oneOf": [
            {
              "enum": [
                "observed",
                "declared",
                "derived"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": null
              },
              "provider": {
                "const": null
              },
              "ref": {
                "const": null
              }
            }
          },
          "else": {
            "properties": {
              "basis": {
                "enum": [
                  "observed",
                  "declared",
                  "derived"
                ]
              },
              "provider": {
                "$ref": "#/$defs/identifier"
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    },
    "precedence": {
      "description": "A recorded precedence claim only. The runtime does not authenticate adoption, decision references, or authority.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "supersedes",
        "decision_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "unresolved",
            "proposed",
            "recorded_adopted"
          ]
        },
        "supersedes": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "decision_ref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "recorded_adopted"
              }
            }
          },
          "then": {
            "properties": {
              "supersedes": {
                "minItems": 1
              },
              "decision_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "\\S"
              }
            }
          },
          "else": {
            "properties": {
              "decision_ref": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "supersedes": {
                "const": []
              }
            }
          }
        }
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "line_start",
        "line_end",
        "quote",
        "guidance_type",
        "automation_status",
        "proposed_check",
        "reason",
        "required_facts",
        "fact_mappings",
        "competing_rule_ids",
        "precedence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000,
          "pattern": "\\S"
        },
        "guidance_type": {
          "enum": [
            "deterministic_constraint",
            "semi_deterministic_pattern",
            "subjective_quality",
            "workflow_process",
            "source_or_scope",
            "content_model",
            "safety_policy",
            "example"
          ]
        },
        "automation_status": {
          "enum": [
            "ready_check",
            "needs_target_mapping",
            "needs_context_mapping",
            "needs_human_threshold",
            "needs_judgment",
            "conflicted",
            "context_only",
            "unsupported"
          ]
        },
        "proposed_check": {
          "oneOf": [
            {
              "enum": [
                "banned_terms",
                "character_limit",
                "required_terminology",
                "required_fields"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "required_facts": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/required_fact"
          }
        },
        "fact_mappings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/fact_mapping"
          }
        },
        "competing_rule_ids": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "precedence": {
          "$ref": "#/$defs/precedence"
        }
      }
    }
  }
}
