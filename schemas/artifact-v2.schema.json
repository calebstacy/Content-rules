{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:content-rules:artifact:2",
  "title": "Context-aware typed content artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "facts",
    "instances"
  ],
  "properties": {
    "schema_version": {
      "const": "content-artifact/2"
    },
    "facts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/fact_assertion"
      }
    },
    "instances": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/instance"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "\\S"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "provider",
        "ref"
      ],
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "declared",
            "derived",
            "inferred"
          ]
        },
        "provider": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        }
      }
    },
    "fact_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fact",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "fact": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "fields",
        "facts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "fields": {
          "type": "object",
          "maxProperties": 200,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/fact_assertion"
          }
        }
      }
    }
  }
}
